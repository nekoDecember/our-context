# Web 画面。LAN 上の別端末からアクセスできます。
APP_PORT=8096
APP_PUBLIC_URL=http://localhost:8096
APP_PASSWORD=
COOKIE_SECURE=false
APP_TIMEZONE=Asia/Tokyo
# 他の Docker ネットワークと重ならない範囲を指定します。
OUR_CONTEXT_SUBNET=10.203.14.0/24

# LiteLLM。API の基準 URL に /v1 を含めます。
LLM_BASE_URL=http://host.docker.internal:4000/v1
LLM_API_KEY=
LLM_INGEST_MODEL=
LLM_QUERY_MODEL=
LLM_TIMEOUT=120
LLM_MAX_ROUNDS=16
LLM_MAX_INPUT_CHARS=80000

# Gitea。URL、所有者、リポジトリ名を設定します。
GITEA_BASE_URL=
GITEA_REPO=
GITEA_BRANCH=main
GITEA_USERNAME=
GITEA_READ_TOKEN=
GITEA_WEBHOOK_SECRET=
# カンマ区切り。指定した Markdown・テキストを読み込みます。
GITEA_ALLOWED_PATHS=work-log.md,context/*.md,context/**/*.md
SYNC_INTERVAL_SECONDS=900
